  {
    "id": "validate-temperature-payload",
    "type": "function",
    "z": "b2c3f9b14c8d4f2a",
    "name": "validate_temperature_payload",
    "func": "const payload = msg.payload || {};\nconst errors = [];\n\nif (!payload.device_id) {\n    errors.push('device_id is required');\n}\n\nif (payload.sensor !== 'MAX30205') {\n    errors.push('sensor must be MAX30205');\n}\n\nif (payload.unit !== 'celsius') {\n    errors.push('unit must be celsius');\n}\n\nif (typeof payload.value_celsius !== 'number' || Number.isNaN(payload.value_celsius)) {\n    errors.push('value_celsius must be a number');\n}\n\nif (errors.length > 0) {\n    node.warn({ error: 'invalid_temperature_payload', errors, payload });\n    msg.payload = { error: 'invalid_temperature_payload', errors, payload };\n    return [null, msg];\n}\n\nmsg.headers = { 'Content-Type': 'application/json' };\nreturn [msg, null];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
